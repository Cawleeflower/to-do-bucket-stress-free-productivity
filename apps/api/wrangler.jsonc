{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "todo-bucket-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "vars": { "APP_ENV": "local" },
  "env": {
    // Deployed as todo-bucket-api-staging and todo-bucket-api-production.
    // vars aren't inherited, so each environment sets its own.
    "staging": { "vars": { "APP_ENV": "staging" } },
    "production": { "vars": { "APP_ENV": "production" } }
  }
}
