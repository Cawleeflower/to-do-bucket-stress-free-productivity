{
  "name": "todo-bucket",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "prepare": "lefthook install",
    "check": "biome check .",
    "fix": "biome check --write .",
    "lint:deps": "depcruise apps packages --config .dependency-cruiser.cjs",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "build": "pnpm lint:deps && pnpm -r run build",
    "test:coverage": "pnpm -r run test:coverage"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "dependency-cruiser": "18.7.2",
    "lefthook": "2.2.2",
    "typescript": "6.0.3"
  }
}
